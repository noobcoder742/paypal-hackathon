{
 "name": "wedding-studio",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "scripts": {
  "build:city": "node scripts/build-city-3d.mjs",
  "predev": "node scripts/build-city-3d.mjs --if-missing",
  "dev": "vite --host 0.0.0.0",
  "prebuild": "node scripts/build-city-3d.mjs --if-missing",
  "build": "vite build",
  "preview": "vite preview",
  "test:map": "node scripts/perf/map-performance.mjs",
  "test": "node --test tests/*.test.mjs",
  "lint": "eslint src server api tests scripts",
  "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"api/**/*.js\" \"tests/**/*.mjs\" \"scripts/**/*.{js,mjs}\""
 },
 "dependencies": {
  "@ai-sdk/anthropic": "^1.2.12",
  "@ai-sdk/google": "^1.2.22",
  "@ai-sdk/react": "^1.2.12",
  "@paypal/agent-toolkit": "1.11.0",
  "@react-three/drei": "^9.122.0",
  "@react-three/fiber": "^8.17.10",
  "@upstash/ratelimit": "^2.2.0",
  "@upstash/redis": "^1.41.0",
  "ag-studio-react": "3.1.0",
  "ai": "^4.3.19",
  "lucide-react": "^0.468.0",
  "react": "^18.3.1",
  "react-dom": "^18.3.1",
  "three": "^0.171.0",
  "zod": "^3.25.76"
 },
 "devDependencies": {
  "eslint": "^9.39.5",
  "eslint-plugin-react": "^7.37.5",
  "eslint-plugin-react-hooks": "^5.2.0",
  "globals": "^15.15.0",
  "prettier": "^3.9.10",
  "vite": "^6.0.5"
 }
}
