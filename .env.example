# Copy to .env.local (never commit it). On Vercel, set these in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: Gemini model id (default gemini-flash-latest, which follows the newest Flash)
GEMINI_MODEL=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HOTEL_DEMO_PASSWORD=
# Optional: live AI runs allowed per day across all visitors (default 40)
AGENT_DAILY_RUNS=
# Public (shipped to the browser)
VITE_PAYPAL_CLIENT_ID=
VITE_AG_STUDIO_LICENSE=

# Shared storage (pick one). Supabase: run docs/supabase.sql once, then set these (server only; never the anon key in the browser):
SUPABASE_URL=
SUPABASE_SECRET_KEY=          # sb_secret_… (or a legacy service_role key in SUPABASE_SERVICE_ROLE_KEY)
